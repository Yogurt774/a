+/*
+ * topaz: liveness beacon, started with boot-arg sweethb=1.
+ *
+ * "HB a" is appended once a second straight to the ring, with no printf and
+ * no locks, so it still arrives when the console path is wedged. A second
+ * thread prints "SWEETHB p" with the same numbers through printf, i.e.
+ * through the console, so it is drawn when the log filter passes SWEETHB.
+ * t is seconds, rd the ring total (every console byte, from any thread), wr
+ * what the flush thread has written to the partition and e its failed
+ * flushes. t growing while rd does not means printf itself is stuck; rd
+ * growing while wr does not means the log flush is stuck; t stopping means
+ * the whole kernel stopped.
+ */
+static int sweet_hb_chan;
+static int sweet_hb2_chan;
+
+static int
+sweet_hb_num(char *p, uint64_t v)
+{
+	char tmp[24];
+	int n = 0, i;
+
+	do {
+		tmp[n++] = (char)('0' + (int)(v % 10));
+		v /= 10;
+	} while (v != 0);
+	for (i = 0; i < n; i++) {
+		p[i] = tmp[n - 1 - i];
+	}
+	return n;
+}
+
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t t = 0, rd, w;
+	char line[128];
+	int n;
+
+	for (;;) {
+		(void)tsleep(&sweet_hb_chan, PZERO, "sweethb", hz);
+		t++;
+		rd = os_atomic_load(&sweet_log_total, relaxed);
+		w = os_atomic_load(&sweet_log_last_flush, relaxed);
+		n = 0;
+		memcpy(line + n, "HB a t=", 7); n += 7;
+		n += sweet_hb_num(line + n, t);
+		memcpy(line + n, " rd=", 4); n += 4;
+		n += sweet_hb_num(line + n, rd);
+		memcpy(line + n, " wr=", 4); n += 4;
+		n += sweet_hb_num(line + n, w);
+		memcpy(line + n, " e=", 3); n += 3;
+		n += sweet_hb_num(line + n, sweet_log_errors);
+		line[n++] = '\n';
+		sweet_log_append(line, n);
+	}
+}
+
+/* The printf beacon must not be able to wedge the appending one. */
+static void
+sweet_hb2_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t t = 0;
+
+	for (;;) {
+		(void)tsleep(&sweet_hb2_chan, PZERO, "sweethb2", hz * 5);
+		t += 5;
+		printf("SWEETHB p t=%llu rd=%llu wr=%llu e=%u\n", t,
+		    os_atomic_load(&sweet_log_total, relaxed),
+		    os_atomic_load(&sweet_log_last_flush, relaxed), sweet_log_errors);
+	}
+}
+
+static void
+sweet_hb_start(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sweethb", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(sweet_hb_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	if (kernel_thread_start(sweet_hb2_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* Root device for rd=ufsroot0 (IOFindBSDRoot). */
 int sweet_ufs_rootdev(dev_t *dev);
 
